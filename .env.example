# 后端环境变量模板。
# 使用方法：cp .env.example .env，然后填入本地或部署环境的值。
# .env 已被 .gitignore 忽略，禁止把真实密钥提交到 Git。

# ---------- PostgreSQL ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DBNAME=xf
PG_USER=postgres
PG_PASSWORD=replace-with-a-strong-password
PG_PREFIX=x_
PG_POOL_MIN_SIZE=5
PG_POOL_MAX_SIZE=20

# ---------- Admin API（admin/main.py） ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440
FRAMEWORK_ADMIN_USERNAME=admin
FRAMEWORK_ADMIN_EMAIL=admin@example.com
FRAMEWORK_ADMIN_PASSWORD=replace-with-at-least-8-characters

# ---------- Site API（site/main.py） ----------
SITE_API_HOST=0.0.0.0
SITE_API_PORT=8100
SITE_URL=http://localhost:3000
SITE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
SITE_UPLOAD_DIR=site/storage

# 管理后台认证与首次初始化（脚本：scripts/bootstrap_site_admin.py）
SITE_ADMIN_EMAIL=owner@example.com
SITE_ADMIN_INITIAL_PASSWORD=replace-with-at-least-8-characters
SITE_ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
SITE_ADMIN_JWT_TTL_MINUTES=480
SITE_ADMIN_AUTO_LOGIN=false
SITE_ADMIN_AUTH_DISABLED=false

# 数据库内模型 / MCP 密钥的 AES-GCM 加密种子。
# 生成：openssl rand -base64 32
SITE_SECRET_KEY=

# ---------- AI 与外部服务（按需开启） ----------
DEFAULT_MODEL_API_KEY=
VISION_MODEL_API_KEY=
TAVILY_API_KEY=
GEWE_API_TOKEN=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 测试专用（可选） ----------
TEST_API_URL=http://localhost:8000
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=
TEST_USER_USERNAME=deptuser
TEST_USER_PASSWORD=
